{
  "name": "hairify",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "npm run sync --silent",
    "start": "expo start",
    "preandroid": "npm run sync --silent",
    "android": "expo start --android",
    "preios": "npm run sync --silent",
    "ios": "expo start --ios",
    "preweb": "npm run sync --silent",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync": "npm run mannequins:sync --silent && npm run hair-types:sync --silent",
    "icons": "node scripts/generate-app-icons.mjs",
    "mannequins": "node scripts/generate-mannequins.mjs",
    "mannequins:sync": "node scripts/sync-mannequin-renders.mjs",
    "mannequins:masks": "node scripts/generate-hair-masks.mjs",
    "try-on": "node scripts/try-on.mjs",
    "hair-types": "node scripts/generate-hair-type-examples.mjs",
    "hair-types:sync": "node scripts/generate-hair-type-examples.mjs --sync"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
