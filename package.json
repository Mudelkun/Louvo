{
  "name": "hairify",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "npm run sync --silent",
    "start": "expo start",
    "preandroid": "npm run sync --silent",
    "android": "expo start --android",
    "preios": "npm run sync --silent",
    "ios": "expo start --ios",
    "preweb": "npm run sync --silent",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync": "npm run mannequins:sync --silent && npm run hair-types:sync --silent",
    "icons": "node scripts/generate-app-icons.mjs",
    "mannequins": "node scripts/generate-mannequins.mjs",
    "mannequins:sync": "node scripts/sync-mannequin-renders.mjs",
    "mannequins:masks": "node scripts/generate-hair-masks.mjs",
    "try-on": "node scripts/try-on.mjs",
    "hair-types": "node scripts/generate-hair-type-examples.mjs",
    "hair-types:sync": "node scripts/generate-hair-type-examples.mjs --sync"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
