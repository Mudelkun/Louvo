{
  "name": "luvo",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "npm run sync --silent",
    "start": "expo start",
    "preandroid": "npm run sync --silent",
    "android": "expo start --android",
    "preios": "npm run sync --silent",
    "ios": "expo start --ios",
    "preweb": "npm run sync --silent",
    "web": "expo start --web",
    "native:prebuild": "expo prebuild --clean",
    "build:dev": "npx eas-cli build --profile development",
    "build:sim": "npx eas-cli build --profile simulator --platform ios",
    "build:preview": "npx eas-cli build --profile preview",
    "build:prod": "npx eas-cli build --profile production",
    "build:list": "npx eas-cli build:list --limit 10",
    "typecheck": "tsc --noEmit",
    "sync": "npm run mannequins:sync --silent && npm run hair-types:sync --silent",
    "icons": "node scripts/generate-app-icons.mjs",
    "mannequins": "node scripts/generate-mannequins.mjs",
    "mannequins:sync": "node scripts/sync-mannequin-renders.mjs",
    "mannequins:masks": "node scripts/generate-hair-masks.mjs",
    "try-on": "node scripts/try-on.mjs",
    "hair-types": "node scripts/generate-hair-type-examples.mjs",
    "hair-types:sync": "node scripts/generate-hair-type-examples.mjs --sync",
    "api": "npm --prefix server run dev",
    "worker": "npm --prefix server run dev:worker",
    "sandbox": "npm --prefix server run sandbox",
    "sandbox:drive": "npm --prefix server run sandbox:drive --",
    "catalog:publish": "npm --prefix server run publish",
    "catalog:publish:dry": "npm --prefix server run publish:dry",
    "catalog:migrate": "npm --prefix server run migrate",
    "catalog:check": "npm --prefix server run check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "private": true
}
