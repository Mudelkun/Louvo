# Hairify catalog API — copy to server/.env and fill in.
#
# The API server itself only needs DATABASE_URL. Everything else here is for the
# publish script, which runs on a laptop rather than in the deployment.

# ---------------------------------------------------------------------------
# Database — Railway injects this into the service automatically.
# ---------------------------------------------------------------------------
# Use the *internal* host for the deployed service (no egress, no TLS) and the
# public proxy host from a laptop.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hairify

# auto (default) | on | off — see server/src/db.ts. `auto` means TLS without
# certificate verification for anything that is not a *.railway.internal host.
# DATABASE_SSL=auto

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT is injected by Railway; 8080 is only for a local run.
# PORT=8080
# LOG_LEVEL=info
# CORS_ORIGIN=*
# How long a built catalog is reused before the revision is re-checked.
# CATALOG_CACHE_MS=30000

# ---------------------------------------------------------------------------
# Cloudflare R2 — publish only. The server never touches the bucket.
# ---------------------------------------------------------------------------
# From the Cloudflare dashboard: R2 -> Overview, the "Account ID" in the sidebar.
R2_ACCOUNT_ID=
# Either spelling is accepted; Cloudflare's dashboard says "Bucket name".
R2_BUCKET=hairify-catalog

# R2 -> Manage API tokens. Needs Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Where phones read the images from — a custom domain on the bucket, or its
# r2.dev subdomain. NOT the S3 endpoint above: that one requires credentials,
# and this URL is baked into the catalog every phone downloads.
R2_PUBLIC_BASE_URL=https://cdn.hairify.app

# Any S3-compatible endpoint works — the publish script signs SigV4 and nothing
# in it is Cloudflare-specific. Set this to move to B2, Bunny or S3.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_REGION=auto

# ---------------------------------------------------------------------------
# Publish source
# ---------------------------------------------------------------------------
# Unset, the publish script reads src/api/mockCatalog.ts — the authoring format.
# Set it to publish from a live catalog instead.
# CATALOG_URL=

# ---------------------------------------------------------------------------
# Preview generation — the API mints the signed urls, the worker does the work.
# ---------------------------------------------------------------------------
# Both are optional. Without them the service is exactly what it was: a catalog
# API. /v1/previews answers 503 previews_unconfigured and the app falls back the
# same way it falls back to the bundled catalog.

# A SECOND bucket, private, with no public domain and no CDN in front of it.
# Never the catalog bucket: that one is public and cached immutable for a year,
# which is precisely what a photograph of somebody's face must never be.
# The same R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_ACCOUNT_ID above are
# reused, so the token needs Object Read & Write on both buckets.
PREVIEW_BUCKET=hairify-transient

# The generator key. Server-side only — this is the whole point of phase 2, and
# EXPO_PUBLIC_FAL_KEY should be removed from app builds once this is live.
FAL_KEY=

# The try-on model. Deliberately not the generators' FAL_EDIT_MODEL: one switch
# moving both would re-point a generator whose model change means re-shooting
# 103 renders. See src/api/tryOn.ts for what each of these costs.
# TRY_ON_MODEL=openai/gpt-image-2/edit
# TRY_ON_QUALITY=medium
# TRY_ON_IMAGE_SIZE=match
# TRY_ON_RESOLUTION=2K

# fal's concurrency limit for the account, which fal sets from credits purchased
# in the last four weeks: 10 at $10, 20 at $100, 30 at $500, 40 at $1000+.
# This is not a safety margin — submitting past the real limit buys rejections,
# not throughput. Raise it when the plan is raised, and not before.
# FAL_MAX_INFLIGHT=10
# How many of those slots one device may hold. One, until the limit is much
# larger: with ten in total, a user pressing Generate five times owns half the
# queue and everybody else waits behind them.
# FAL_MAX_INFLIGHT_PER_DEVICE=1

# How long the phone has to upload before its job is abandoned, and how long a
# signed download url lasts. Minutes, not hours, for both.
# PREVIEW_UPLOAD_TTL_S=900
# PREVIEW_DOWNLOAD_TTL_S=900

# The hand-off window. NOT a retention policy: a preview lives on the phone that
# generated it, permanently, until its owner deletes it. This is how long our
# copy waits to be collected before it is deleted unread.
# PREVIEW_RETENTION_DAYS=7

# Refused above this, before a signature is minted. The app downscales to a
# ~1536px longest edge first, so a real upload is a few hundred KB.
# PREVIEW_MAX_UPLOAD_BYTES=12582912

# How often the worker looks for something to do.
# WORKER_POLL_MS=2000

# ---------------------------------------------------------------------------
# Sharing and referral — all optional, and all of it degrades to something
# honest. See docs/sharing.md.
# ---------------------------------------------------------------------------
# The public origin serving /s/<code>. Unset, the landing page uses the origin
# the request arrived on, which on Railway is the deployment url and works.
# Set it once a real domain points here, so links in other people's chat
# histories keep resolving after a redeploy.
# SHARE_BASE_URL=https://hairify.app

# Must agree with `expo.scheme` in app.json. This is what makes a shared link
# open the app somebody already has rather than a page telling them to install.
# APP_SCHEME=hairify

# Where the landing page sends someone who does not have the app. With neither
# set the page offers the deep link alone rather than linking somewhere that
# 404s — a broken download button is a worse advertisement than an absent one.
# IOS_APP_STORE_URL=https://apps.apple.com/app/id0000000000
# ANDROID_PLAY_URL=https://play.google.com/store/apps/details?id=com.hairify.app

# ANDROID_PACKAGE=com.hairify.app
# IOS_BUNDLE_ID=com.hairify.app
# The numeric App Store id, for the iOS smart app banner.
# IOS_APP_ID=0000000000

# Universal / app links. Both association files 404 until these are set, on
# purpose: an apple-app-site-association naming a team id that is not ours is
# worse than none, because iOS caches it.
# IOS_TEAM_ID=ABCDE12345
# ANDROID_SHA256_FINGERPRINTS=AA:BB:CC:...
