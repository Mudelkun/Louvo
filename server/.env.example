# Hairify catalog API — copy to server/.env and fill in.
#
# The API server itself only needs DATABASE_URL. Everything else here is for the
# publish script, which runs on a laptop rather than in the deployment.

# ---------------------------------------------------------------------------
# Database — Railway injects this into the service automatically.
# ---------------------------------------------------------------------------
# Use the *internal* host for the deployed service (no egress, no TLS) and the
# public proxy host from a laptop.
DATABASE_URL=postgresql://postgres:password@localhost:5432/hairify

# auto (default) | on | off — see server/src/db.ts. `auto` means TLS without
# certificate verification for anything that is not a *.railway.internal host.
# DATABASE_SSL=auto

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT is injected by Railway; 8080 is only for a local run.
# PORT=8080
# LOG_LEVEL=info
# CORS_ORIGIN=*
# How long a built catalog is reused before the revision is re-checked.
# CATALOG_CACHE_MS=30000

# ---------------------------------------------------------------------------
# Cloudflare R2 — publish only. The server never touches the bucket.
# ---------------------------------------------------------------------------
# From the Cloudflare dashboard: R2 -> Overview, the "Account ID" in the sidebar.
R2_ACCOUNT_ID=
# Either spelling is accepted; Cloudflare's dashboard says "Bucket name".
R2_BUCKET=hairify-catalog

# R2 -> Manage API tokens. Needs Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Where phones read the images from — a custom domain on the bucket, or its
# r2.dev subdomain. NOT the S3 endpoint above: that one requires credentials,
# and this URL is baked into the catalog every phone downloads.
R2_PUBLIC_BASE_URL=https://cdn.hairify.app

# Any S3-compatible endpoint works — the publish script signs SigV4 and nothing
# in it is Cloudflare-specific. Set this to move to B2, Bunny or S3.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_REGION=auto

# ---------------------------------------------------------------------------
# Publish source
# ---------------------------------------------------------------------------
# Unset, the publish script reads src/api/mockCatalog.ts — the authoring format.
# Set it to publish from a live catalog instead.
# CATALOG_URL=
