{
  "name": "hairify-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hairify catalog API — hairstyle metadata from Postgres, imagery from R2.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=../.env.local src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "publish": "node scripts/publish-catalog.mjs",
    "publish:dry": "node scripts/publish-catalog.mjs --dry-run",
    "publish:metadata": "node scripts/publish-catalog.mjs --metadata-only",
    "check": "node scripts/check-roundtrip.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/etag": "^6.0.3",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.14",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
