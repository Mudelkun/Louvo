{
  "expo": {
    "name": "Louvo",
    "slug": "luvo",
    "scheme": "luvo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luvoai.luvo",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Louvo needs access to your photos so you can try hairstyles on your own picture.",
        "NSCameraUsageDescription": "Louvo needs your camera so you can take a selfie to try hairstyles on."
      },
      "associatedDomains": [
        "applinks:louvo.app"
      ],
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.luvoai.luvo",
      "adaptiveIcon": {
        "backgroundColor": "#0d0914",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "louvo.app",
              "pathPrefix": "/s"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Louvo needs access to your photos so you can try hairstyles on your own picture.",
          "cameraPermission": "Louvo needs your camera so you can take a selfie to try hairstyles on."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Louvo needs your camera so you can take a selfie to try hairstyles on.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Louvo needs access to your photos so you can try hairstyles on your own picture.",
          "savePhotosPermission": "Louvo needs permission to save hairstyle previews to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9F8FC",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#100C18"
          },
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-sharing",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a67954d9-040e-466f-9bb0-da765f8f1ab5"
      }
    },
    "owner": "mudelkuns-team"
  }
}
