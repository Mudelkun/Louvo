{
  "expo": {
    "name": "Hairify",
    "slug": "hairify",
    "scheme": "hairify",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hairify.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Hairify needs access to your photos so you can try hairstyles on your own picture.",
        "NSCameraUsageDescription": "Hairify needs your camera so you can take a selfie to try hairstyles on."
      },
      "associatedDomains": [
        "applinks:hairify.app"
      ]
    },
    "android": {
      "package": "com.hairify.app",
      "adaptiveIcon": {
        "backgroundColor": "#171716",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hairify.app",
              "pathPrefix": "/s"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Hairify needs access to your photos so you can try hairstyles on your own picture.",
          "cameraPermission": "Hairify needs your camera so you can take a selfie to try hairstyles on."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hairify needs your camera so you can take a selfie to try hairstyles on."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Hairify needs access to your photos so you can try hairstyles on your own picture.",
          "savePhotosPermission": "Hairify needs permission to save hairstyle previews to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#15130F"
          },
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
