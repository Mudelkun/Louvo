{
  "name": "luvo-web",
  "version": "0.1.0",
  "private": true,
  "description": "Luvo on the web — the premium virtual hairstyle atelier.",
  "scripts": {
    "sync": "node scripts/sync-contract.mjs",
    "sync:check": "node scripts/sync-contract.mjs --check",
    "predev": "node scripts/sync-contract.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/sync-contract.mjs --check",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "node scripts/sync-contract.mjs --check && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "next": "^16.3.4",
    "react": "^19.1.4",
    "react-dom": "^19.1.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.2"
  }
}
